{
  "name": "rp2040-zero",
  "version": "1.0.0",
  "kind": "board",
  "description": "Waveshare RP2040-Zero bare-metal USB diagnostics",
  "license": "MIT",
  "dependencies": {
    "llvm-wasm": "^1.0.0"
  },
  "metadata": {
    "manufacturer": "Waveshare",
    "mcu": "RP2040",
    "architecture": "armv6m",
    "cpu": "cortex-m0plus",
    "platform": "raspberrypi-rp2040-zero",
    "framework": "bare-metal",
    "flashCapacityBytes": 2097152,
    "sramCapacityBytes": 270336,
    "clockHz": 48000000,
    "crystalHz": 12000000,
    "flashAddress": "0x10000000",
    "sramAddress": "0x20000000",
    "rgbLed": {
      "pin": 16,
      "kind": "WS2812",
      "implemented": false
    },
    "build": {
      "kind": "firmware",
      "target": "armv6m",
      "targetOptions": {
        "mcpu": "cortex-m0plus"
      },
      "source": "main.c",
      "startupSource": "boot2.s",
      "linkerScript": "rp2040.ld",
      "firmwareFormat": "rp2040-bin",
      "output": ".wicro/build"
    },
    "frameworkConfigurations": {
      "arduino": {
        "replaceDependencies": true,
        "dependencies": {
          "llvm-wasm": "^1.0.0",
          "rp2040-arduino-sdk": "^6.4.0"
        },
        "metadata": {
          "platform": "raspberrypi-arduino-pico",
          "clockHz": 125000000,
          "picoArduino": {
            "chip": "rp2040",
            "variant": "waveshare_rp2040_zero",
            "wifi": false
          },
          "build": {
            "kind": "firmware",
            "source": "main.ino",
            "firmwareFormat": "bin"
          }
        }
      }
    }
  }
}
