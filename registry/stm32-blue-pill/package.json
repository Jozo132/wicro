{
  "name": "stm32-blue-pill",
  "version": "1.0.0",
  "kind": "board",
  "description": "STM32 Blue Pill STM32F103CB Arduino preset",
  "license": "MIT",
  "dependencies": {
    "arduino-stm32-core": "^1.0.0",
    "llvm-wasm": "^1.0.0"
  },
  "metadata": {
    "manufacturer": "STMicroelectronics",
    "mcu": "STM32F103CB",
    "architecture": "armv7-m",
    "cpu": "cortex-m3",
    "framework": "arduino",
    "clockHz": 72000000,
    "flashCapacityBytes": 131072,
    "sramCapacityBytes": 20480,
    "flashAddress": "0x08000000",
    "sramAddress": "0x20000000",
    "build": {
      "kind": "bare-metal",
      "target": "armv7-m",
      "targetOptions": {
        "mcpu": "cortex-m3"
      },
      "source": "main.ino",
      "startupSource": "startup.c",
      "linkerScript": "stm32f103cb.ld",
      "output": ".wicro/build"
    },
    "status": "preset",
    "platform": "st-stm32-bare-metal",
    "frameworkConfigurations": {
      "arduino": {
        "dependencies": {
          "stm32-f1-arduino-sdk": "^1.0.0",
          "llvm-wasm": "^1.0.0"
        },
        "metadata": {
          "clockHz": 72000000,
          "arduino": {
            "series": "STM32F1xx",
            "productLine": "STM32F103xB",
            "variant": "STM32F1xx/F103C8T_F103CB(T-U)",
            "board": "GENERIC_F103CBTX",
            "startup": "startup_stm32f103xb.s",
            "multilib": "v7-m/nofp",
            "led": "PC13",
            "usb": true
          },
          "build": {
            "kind": "firmware",
            "source": "main.ino",
            "firmwareFormat": "bin"
          }
        },
        "replaceDependencies": true
      }
    }
  }
}
