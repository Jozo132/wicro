{
  "name": "arduino-uno-original",
  "version": "1.0.0",
  "kind": "board",
  "description": "Original Arduino UNO board package",
  "license": "MIT",
  "dependencies": {
    "llvm-wasm": "^1.0.0",
    "avr-arduino-sdk": "^1.0.0"
  },
  "metadata": {
    "manufacturer": "Arduino",
    "mcu": "ATmega328P",
    "package": "DIP-28",
    "architecture": "avr",
    "framework": "arduino",
    "cpu": "avr5",
    "build": {
      "kind": "firmware",
      "target": "avr",
      "targetOptions": {
        "mcu": "atmega328p"
      },
      "source": "main.ino",
      "output": ".wicro/build",
      "firmwareFormat": "avr-bin"
    },
    "clockHz": 16000000,
    "flashCapacityBytes": 32256,
    "sramCapacityBytes": 2048,
    "eepromCapacityBytes": 1024,
    "flashAddress": "0x0000",
    "led": {
      "port": "B",
      "pin": 5,
      "activeLow": false
    },
    "platform": "arduino-avr",
    "avr": {
      "mcu": "atmega328p",
      "variant": "standard",
      "multilib": "avr5",
      "ramOrigin": 256,
      "name": "UNO-ORIGINAL",
      "usb": false
    },
    "firmwareLinking": "wasm-arduino"
  }
}
