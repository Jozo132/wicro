{
  "name": "arduino-uno-original",
  "version": "1.0.0",
  "kind": "board",
  "description": "Original Arduino UNO board package",
  "license": "MIT",
  "dependencies": {
    "arduino-avr-core": "^1.0.0",
    "llvm-wasm-espressif": "^20.1.1"
  },
  "metadata": {
    "manufacturer": "Arduino",
    "mcu": "ATmega328P",
    "package": "DIP-28",
    "architecture": "avr",
    "framework": "arduino",
    "cpu": "avr5",
    "build": {
      "kind": "object",
      "target": "avr",
      "targetOptions": { "mcu": "atmega328p" },
      "source": "main.c",
      "output": ".wicro/build"
    },
    "clockHz": 16000000,
    "flashCapacityBytes": 32256,
    "sramCapacityBytes": 2048,
    "eepromCapacityBytes": 1024,
    "flashAddress": "0x0000",
    "led": { "port": "B", "pin": 5, "activeLow": false }
  }
}
