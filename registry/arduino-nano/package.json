{
  "name": "arduino-nano",
  "version": "1.0.0",
  "kind": "board",
  "description": "Arduino Nano ATmega328P preset",
  "license": "MIT",
  "dependencies": {
    "nano-arduino-sdk": "^1.0.0",
    "llvm-wasm": "^1.0.0"
  },
  "metadata": {
    "manufacturer": "Arduino",
    "mcu": "ATmega328P",
    "architecture": "avr",
    "framework": "arduino",
    "cpu": "avr5",
    "clockHz": 16000000,
    "flashCapacityBytes": 30720,
    "sramCapacityBytes": 2048,
    "eepromCapacityBytes": 1024,
    "build": {
      "kind": "firmware",
      "target": "avr",
      "targetOptions": {
        "mcu": "atmega328p"
      },
      "source": "main.ino",
      "output": ".wicro/build",
      "firmwareFormat": "avr-bin"
    },
    "menus": {
      "cpu": {
        "atmega328": "ATmega328P",
        "atmega328old": "ATmega328P (old bootloader, 57600 baud)"
      }
    },
    "status": "implemented",
    "firmwareLinking": "wasm-arduino-sdk",
    "platform": "arduino-nano-avr",
    "uploadBaud": 115200,
    "monitorBaud": 115200,
    "usbVendorId": "1a86",
    "usbProductId": "7523"
  }
}
