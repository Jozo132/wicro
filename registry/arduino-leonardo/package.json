{
  "name": "arduino-leonardo",
  "version": "1.0.0",
  "kind": "board",
  "description": "Arduino Leonardo ATmega32U4 preset",
  "license": "MIT",
  "dependencies": {
    "llvm-wasm": "^1.0.0",
    "avr-arduino-sdk": "^1.0.0"
  },
  "metadata": {
    "manufacturer": "Arduino",
    "mcu": "ATmega32U4",
    "architecture": "avr",
    "framework": "arduino",
    "cpu": "avr5",
    "clockHz": 16000000,
    "flashCapacityBytes": 28672,
    "sramCapacityBytes": 2560,
    "eepromCapacityBytes": 1024,
    "build": {
      "kind": "firmware",
      "target": "avr",
      "targetOptions": {
        "mcu": "atmega32u4"
      },
      "source": "main.ino",
      "output": ".wicro/build",
      "firmwareFormat": "avr-bin"
    },
    "firmwareLinking": "wasm-arduino",
    "platform": "arduino-avr",
    "avr": {
      "mcu": "atmega32u4",
      "variant": "leonardo",
      "multilib": "avr5",
      "ramOrigin": 256,
      "name": "LEONARDO",
      "usb": true
    }
  }
}
