{
  "name": "esp32-original-bare-metal",
  "version": "1.0.0",
  "kind": "board",
  "description": "Original ESP32 LX6 RAM-only ROM firmware (4 MiB / 40 MHz crystal)",
  "license": "MIT",
  "dependencies": {
    "llvm-wasm": "^1.0.0"
  },
  "metadata": {
    "manufacturer": "Espressif",
    "mcu": "ESP32",
    "architecture": "xtensa",
    "cpu": "xtensa-lx6",
    "platform": "espressif-esp32-original-bare-metal",
    "framework": "bare-metal",
    "flashCapacityBytes": 4194304,
    "crystalHz": 40000000,
    "uploadBaud": 115200,
    "monitorBaud": 115200,
    "build": {
      "kind": "firmware",
      "target": "xtensa",
      "targetOptions": {
        "mcpu": "esp32"
      },
      "source": "main.c",
      "startupSource": "startup.s",
      "linkerScript": "esp32.ld",
      "firmwareFormat": "esp32-original-rom",
      "output": ".wicro/build"
    }
  }
}
