{
  "name": "rp2040",
  "version": "1.0.0",
  "kind": "board",
  "description": "Raspberry Pi RP2040 board package",
  "license": "MIT",
  "dependencies": {
    "arduino-pico": "^1.0.0",
    "llvm-wasm": "^1.0.0",
    "pico-sdk": "^2.1.0"
  },
  "metadata": {
    "manufacturer": "Raspberry Pi",
    "mcu": "RP2040",
    "architecture": "armv6m",
    "framework": "arduino",
    "build": {
      "kind": "object",
      "target": "armv6m",
      "targetOptions": {
        "mcpu": "cortex-m0plus"
      },
      "source": "main.c",
      "output": ".wicro/build"
    },
    "cpu": "cortex-m0plus",
    "flashCapacityBytes": 2097152,
    "sramCapacityBytes": 270336,
    "clockHz": 125000000,
    "flashAddress": "0x10000000",
    "sramAddress": "0x20000000",
    "led": {
      "pin": 25,
      "activeLow": false
    },
    "frameworkConfigurations": {
      "arduino": {
        "replaceDependencies": true,
        "dependencies": {
          "llvm-wasm": "^1.0.0",
          "rp2040-arduino-sdk": "^6.4.0"
        },
        "metadata": {
          "platform": "raspberrypi-arduino-pico",
          "clockHz": 125000000,
          "picoArduino": {
            "chip": "rp2040",
            "variant": "rpipico",
            "wifi": false
          },
          "build": {
            "kind": "firmware",
            "source": "main.ino",
            "firmwareFormat": "bin"
          }
        }
      }
    }
  }
}
