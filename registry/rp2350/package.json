{
  "name": "rp2350",
  "version": "1.0.0",
  "kind": "board",
  "description": "Raspberry Pi RP2350 board package",
  "license": "MIT",
  "dependencies": {
    "arduino-pico": "^1.0.0",
    "llvm-wasm-espressif": "^20.1.1",
    "pico-sdk": "^2.1.0"
  },
  "metadata": {
    "manufacturer": "Raspberry Pi",
    "mcu": "RP2350",
    "architecture": "armv8m-mainline",
    "framework": "arduino",
    "build": {
      "kind": "object",
      "target": "armv8m-mainline",
      "targetOptions": { "mcpu": "cortex-m33" },
      "source": "main.c",
      "output": ".wicro/build"
    },
    "cpu": "cortex-m33",
    "flashCapacityBytes": 4194304,
    "sramCapacityBytes": 532480,
    "clockHz": 150000000,
    "flashAddress": "0x10000000",
    "sramAddress": "0x20000000",
    "led": { "pin": 25, "activeLow": false }
  }
}
