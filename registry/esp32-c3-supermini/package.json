{
  "name": "esp32-c3-supermini",
  "version": "1.0.0",
  "kind": "board",
  "description": "ESP32-C3 SuperMini board package",
  "license": "MIT",
  "dependencies": {
    "esp-idf": "^6.1.0",
    "llvm-wasm-espressif": "^20.1.1"
  },
  "metadata": {
    "manufacturer": "Espressif",
    "mcu": "ESP32-C3",
    "architecture": "riscv32",
    "build": {
      "kind": "object",
      "target": "riscv32",
      "targetOptions": { "march": "rv32imc", "mabi": "ilp32" },
      "source": "main/main.c",
      "output": ".wicro/build"
    },
    "flashAutoDetect": true,
    "led": { "pin": 8, "activeLow": true },
    "bootPin": 9,
    "nativeUsbPins": [18, 19],
    "usbVendorId": "303a",
    "usbProductId": "1001",
    "uploadBaud": 460800,
    "monitorBaud": 115200,
    "memory": {
      "iram": "0x4037c000",
      "dram": "0x3fc80000"
    }
  }
}
