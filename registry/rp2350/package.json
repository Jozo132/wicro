{
  "name": "rp2350",
  "version": "1.0.0",
  "kind": "board",
  "description": "Generic RP2350 cortex-m33 bare-metal USB diagnostics",
  "license": "MIT",
  "dependencies": {
    "llvm-wasm": "^1.0.0"
  },
  "metadata": {
    "manufacturer": "Generic",
    "mcu": "RP2350",
    "architecture": "armv8m-mainline",
    "cpu": "cortex-m33",
    "platform": "raspberrypi-rp2350",
    "framework": "bare-metal",
    "flashCapacityBytes": 2097152,
    "sramCapacityBytes": 532480,
    "clockHz": 48000000,
    "crystalHz": 12000000,
    "flashAddress": "0x10000000",
    "sramAddress": "0x20000000",
    "build": {
      "kind": "firmware",
      "target": "armv8m-mainline",
      "targetOptions": {
        "mcpu": "cortex-m33"
      },
      "source": "main.c",
      "linkerScript": "rp2350.ld",
      "firmwareFormat": "rp2350-bin",
      "output": ".wicro/build"
    },
    "frameworkConfigurations": {
      "arduino": {
        "replaceDependencies": true,
        "dependencies": {
          "llvm-wasm": "^1.0.0",
          "rp2350-arduino-sdk": "^6.4.0"
        },
        "metadata": {
          "platform": "raspberrypi-arduino-pico",
          "clockHz": 150000000,
          "picoArduino": {
            "chip": "rp2350",
            "variant": "generic_rp2350",
            "wifi": false
          },
          "build": {
            "kind": "firmware",
            "source": "main.ino",
            "firmwareFormat": "bin"
          }
        }
      }
    }
  }
}
