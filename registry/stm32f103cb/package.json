{
  "name": "stm32f103cb",
  "version": "1.0.0",
  "kind": "board",
  "description": "STM32F103CB Blue Pill compatible board package",
  "license": "MIT",
  "dependencies": {
    "llvm-wasm": "^20.1.1",
    "cmsis-stm32f1": "^1.0.0"
  },
  "metadata": {
    "manufacturer": "STMicroelectronics",
    "mcu": "STM32F103CB",
    "platform": "st-stm32-bare-metal",
    "package": "LQFP48",
    "architecture": "armv7-m",
    "cpu": "cortex-m3",
    "build": {
      "kind": "bare-metal",
      "target": "armv7-m",
      "targetOptions": { "mcpu": "cortex-m3" },
      "source": "main.c",
      "startupSource": "startup.c",
      "linkerScript": "stm32f103cb.ld",
      "output": ".wicro/build"
    },
    "flashCapacityBytes": 131072,
    "sramCapacityBytes": 20480,
    "clockHz": 72000000,
    "flashAddress": "0x08000000",
    "sramAddress": "0x20000000",
    "led": { "port": "C", "pin": 13, "activeLow": true }
  }
}
