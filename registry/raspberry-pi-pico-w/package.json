{
  "name": "raspberry-pi-pico-w",
  "version": "1.0.0",
  "kind": "board",
  "description": "Raspberry Pi Pico W Arduino preset",
  "license": "MIT",
  "dependencies": {
    "arduino-pico": "^1.0.0",
    "llvm-wasm": "^1.0.0"
  },
  "metadata": {
    "manufacturer": "Raspberry Pi",
    "mcu": "RP2040",
    "architecture": "armv6m",
    "cpu": "cortex-m0plus",
    "framework": "arduino",
    "clockHz": 133000000,
    "flashCapacityBytes": 2097152,
    "sramCapacityBytes": 264192,
    "build": {
      "kind": "object",
      "target": "armv6m",
      "targetOptions": {
        "mcpu": "cortex-m0plus"
      },
      "source": "main.ino",
      "output": ".wicro/build"
    },
    "wireless": {
      "wifi": true,
      "bluetooth": false
    },
    "status": "preset",
    "firmwareLinking": "pending-sdk-distribution",
    "frameworkConfigurations": {
      "arduino": {
        "replaceDependencies": true,
        "dependencies": {
          "llvm-wasm": "^1.0.0",
          "rp2040-arduino-sdk": "^6.4.0"
        },
        "metadata": {
          "platform": "raspberrypi-arduino-pico",
          "clockHz": 125000000,
          "picoArduino": {
            "chip": "rp2040",
            "variant": "rpipicow",
            "wifi": true
          },
          "build": {
            "kind": "firmware",
            "source": "main.ino",
            "firmwareFormat": "bin"
          }
        }
      }
    }
  }
}
