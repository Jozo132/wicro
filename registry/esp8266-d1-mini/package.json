{
  "name": "esp8266-d1-mini",
  "version": "1.0.0",
  "kind": "board",
  "description": "ESP8266 D1 Mini Arduino preset",
  "license": "MIT",
  "dependencies": {
    "arduino-esp8266": "^3.1.2",
    "llvm-wasm": "^1.0.0"
  },
  "metadata": {
    "manufacturer": "Wemos",
    "mcu": "ESP8266",
    "architecture": "xtensa",
    "cpu": "xtensa-l106",
    "framework": "arduino",
    "clockHz": 80000000,
    "flashCapacityBytes": 4194304,
    "sramCapacityBytes": 81920,
    "uploadBaud": 115200,
    "monitorBaud": 115200,
    "build": {
      "kind": "object",
      "target": "xtensa",
      "targetOptions": {
        "mcpu": "esp8266"
      },
      "source": "main.ino",
      "output": ".wicro/build"
    },
    "status": "preset",
    "firmwareLinking": "pending-sdk-distribution",
    "frameworkConfigurations": {
      "arduino": {
        "replaceDependencies": true,
        "dependencies": {
          "llvm-wasm": "^1.0.0",
          "esp8266-arduino-sdk": "^3.1.2"
        },
        "metadata": {
          "platform": "espressif-esp8266-arduino",
          "clockHz": 80000000,
          "esp8266Arduino": {
            "variant": "d1_mini"
          },
          "build": {
            "kind": "firmware",
            "source": "main.ino",
            "firmwareFormat": "esp8266-arduino",
            "targetOptions": {
              "mcpu": "esp8266"
            }
          }
        }
      }
    }
  }
}
