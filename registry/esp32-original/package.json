{
  "name": "esp32-original",
  "version": "1.0.0",
  "kind": "board",
  "description": "Original ESP32 Xtensa board package",
  "license": "MIT",
  "dependencies": {
    "arduino-esp32": "^1.0.0",
    "esp-idf": "^6.1.0",
    "llvm-wasm": "^20.1.1"
  },
  "metadata": {
    "manufacturer": "Espressif",
    "mcu": "ESP32",
    "architecture": "xtensa",
    "framework": "arduino",
    "build": {
      "kind": "object",
      "target": "xtensa",
      "targetOptions": { "mcpu": "esp32" },
      "source": "main/main.c",
      "output": ".wicro/build"
    },
    "cpu": "xtensa-lx6",
    "flashCapacityBytes": 4194304,
    "sramCapacityBytes": 520192,
    "led": { "pin": 2, "activeLow": false },
    "bootPin": 0,
    "uploadBaud": 460800,
    "monitorBaud": 115200
  }
}
