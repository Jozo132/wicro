{
  "name": "wicro-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Wicro monorepo",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present && node --test tests/*.test.js",
    "test:integration": "node --test tests/*.test.js",
    "check:types": "node scripts/check-types.js",
    "pack:check": "npm pack --dry-run --workspace @jozo132/wicro",
    "publish:dry-run": "npm publish --dry-run --workspace @jozo132/wicro --access public",
    "dev:web": "npm run dev --workspace @wicro/web",
    "build:web": "npm run build --workspace @wicro/web",
    "benchmark:llvm": "node scripts/benchmark-llvm-wasm.js",
    "build:llvm": "node scripts/build-llvm-wasm.js unified",
    "build:llvm:dry-run": "node scripts/build-llvm-wasm.js unified --dry-run",
    "build:llvm:cache": "node scripts/build-llvm-wasm.js unified --cache-only",
    "test:llvm-build": "node --test scripts/build-llvm-wasm.test.js",
    "test:llvm-release": "node --test scripts/release-llvm-wasm.test.js",
    "test:esp32-hardware": "node --test tests/esp32-c3-hardware.test.js",
    "release:llvm:status": "node scripts/release-llvm-wasm.js status",
    "release:llvm:prepare": "node scripts/release-llvm-wasm.js prepare",
    "release:llvm:dry-run": "node scripts/release-llvm-wasm.js dry-run",
    "release:llvm:publish": "node scripts/release-llvm-wasm.js publish",
    "release:llvm:verify": "node scripts/release-llvm-wasm.js verify",
    "test:remote-assets": "node --test tests/remote-assets.test.js",
    "check:remote-assets": "node scripts/check-remote-assets.js",
    "test:libraries:live": "node scripts/test-libraries-live.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@vscode/test-electron": "^3.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.1.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "playwright": "^1.65.1",
    "semver": "^7.8.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@serialport/parser-readline": "^13.0.0",
    "@yowasp/clang": "^22.0.0-git20695-13",
    "esptool-js": "^0.7.1",
    "monaco-editor": "^0.57.0",
    "serialport": "^13.0.0",
    "usb": "^3.3.1",
    "vite": "^8.3.8"
  }
}
