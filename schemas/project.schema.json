{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wicro project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "board": { "type": "string" },
    "framework": { "type": "string" },
    "toolchain": { "type": "string" },
    "packages": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "name"],
        "properties": {
          "provider": { "enum": ["arduino", "platformio", "archive"] },
          "name": { "type": "string", "minLength": 1 },
          "owner": { "type": "string" },
          "version": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "archiveType": { "enum": ["zip", "tar.gz"] }
        }
      }
    },
    "upload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "programmer": { "type": "string" },
        "protocol": { "type": "string" },
        "baudRate": { "type": "integer", "minimum": 1, "maximum": 2000000 },
        "verify": { "enum": ["none", "readback"] },
        "autoMonitor": { "type": "boolean" },
        "monitorBaudRate": { "type": "integer", "minimum": 1, "maximum": 2000000 }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "flags": { "type": "array", "items": { "type": "string" } },
        "defines": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
