{
  "name": "arduino-mega",
  "version": "1.0.0",
  "kind": "board",
  "description": "Arduino Mega 2560 preset",
  "license": "MIT",
  "dependencies": {
    "llvm-wasm": "^1.0.0",
    "avr-arduino-sdk": "^1.0.0"
  },
  "metadata": {
    "manufacturer": "Arduino",
    "mcu": "ATmega2560",
    "architecture": "avr",
    "framework": "arduino",
    "cpu": "avr6",
    "clockHz": 16000000,
    "flashCapacityBytes": 253952,
    "sramCapacityBytes": 8192,
    "eepromCapacityBytes": 4096,
    "build": {
      "kind": "firmware",
      "target": "avr",
      "targetOptions": {
        "mcu": "atmega2560"
      },
      "source": "main.ino",
      "output": ".wicro/build",
      "firmwareFormat": "avr-bin"
    },
    "menus": {
      "cpu": {
        "atmega2560": "ATmega2560"
      }
    },
    "firmwareLinking": "wasm-arduino",
    "platform": "arduino-avr",
    "avr": {
      "mcu": "atmega2560",
      "variant": "mega",
      "multilib": "avr6",
      "ramOrigin": 512,
      "name": "MEGA",
      "usb": false
    }
  }
}
