{
  "name": "stm32-nucleo-f401re",
  "version": "1.0.0",
  "kind": "board",
  "description": "STM32 Nucleo-F401RE Arduino preset",
  "license": "MIT",
  "dependencies": {
    "arduino-stm32-core": "^1.0.0",
    "llvm-wasm": "^1.0.0"
  },
  "metadata": {
    "manufacturer": "STMicroelectronics",
    "mcu": "STM32F401RE",
    "architecture": "armv7e-m",
    "cpu": "cortex-m4",
    "framework": "arduino",
    "clockHz": 84000000,
    "flashCapacityBytes": 524288,
    "sramCapacityBytes": 98304,
    "flashAddress": "0x08000000",
    "sramAddress": "0x20000000",
    "build": {
      "kind": "bare-metal",
      "target": "armv7e-m",
      "targetOptions": {
        "mcpu": "cortex-m4"
      },
      "source": "main.ino",
      "startupSource": "startup.c",
      "linkerScript": "stm32f401re.ld",
      "output": ".wicro/build"
    },
    "status": "preset",
    "platform": "st-stm32-bare-metal",
    "frameworkConfigurations": {
      "arduino": {
        "dependencies": {
          "stm32-f4-arduino-sdk": "^1.0.0",
          "llvm-wasm": "^1.0.0"
        },
        "metadata": {
          "clockHz": 84000000,
          "arduino": {
            "series": "STM32F4xx",
            "productLine": "STM32F401xE",
            "variant": "STM32F4xx/F401R(B-C-D-E)T",
            "board": "NUCLEO_F401RE",
            "startup": "startup_stm32f401xe.s",
            "multilib": "v7e-m+fp/hard",
            "led": "PA5",
            "usb": false
          },
          "build": {
            "kind": "firmware",
            "source": "main.ino",
            "firmwareFormat": "bin"
          }
        },
        "replaceDependencies": true
      }
    }
  }
}
