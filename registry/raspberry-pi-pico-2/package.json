{
  "name": "raspberry-pi-pico-2",
  "version": "1.0.0",
  "kind": "board",
  "description": "Raspberry Pi Pico 2 Arduino preset",
  "license": "MIT",
  "dependencies": {
    "arduino-pico": "^1.0.0",
    "llvm-wasm": "^1.0.0"
  },
  "metadata": {
    "manufacturer": "Raspberry Pi",
    "mcu": "RP2350",
    "architecture": "armv8m-mainline",
    "cpu": "cortex-m33",
    "framework": "arduino",
    "clockHz": 150000000,
    "flashCapacityBytes": 4194304,
    "sramCapacityBytes": 532480,
    "build": {
      "kind": "object",
      "target": "armv8m-mainline",
      "targetOptions": {
        "mcpu": "cortex-m33"
      },
      "source": "main.ino",
      "output": ".wicro/build"
    },
    "status": "preset",
    "firmwareLinking": "pending-sdk-distribution",
    "frameworkConfigurations": {
      "arduino": {
        "replaceDependencies": true,
        "dependencies": {
          "llvm-wasm": "^1.0.0",
          "rp2350-arduino-sdk": "^6.4.0"
        },
        "metadata": {
          "platform": "raspberrypi-arduino-pico",
          "clockHz": 150000000,
          "picoArduino": {
            "chip": "rp2350",
            "variant": "rpipico2",
            "wifi": false
          },
          "build": {
            "kind": "firmware",
            "source": "main.ino",
            "firmwareFormat": "bin"
          }
        }
      }
    }
  }
}
