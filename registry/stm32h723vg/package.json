{
  "name": "stm32h723vg",
  "version": "1.0.0",
  "kind": "board",
  "description": "STM32H723VG board package",
  "license": "MIT",
  "dependencies": {
    "llvm-wasm": "^1.0.0",
    "cmsis-stm32h7": "^1.0.0"
  },
  "metadata": {
    "manufacturer": "STMicroelectronics",
    "mcu": "STM32H723VG",
    "package": "TFBGA100",
    "architecture": "armv7e-m",
    "cpu": "cortex-m7",
    "build": {
      "kind": "bare-metal",
      "target": "armv7e-m",
      "targetOptions": {
        "mcpu": "cortex-m7"
      },
      "source": "main.c",
      "startupSource": "startup.c",
      "linkerScript": "stm32h723vg.ld",
      "output": ".wicro/build"
    },
    "fpu": "fpv5-d16",
    "flashCapacityBytes": 1048576,
    "sramCapacityBytes": 564992,
    "clockHz": 550000000,
    "flashAddress": "0x08000000",
    "sramAddress": "0x24000000",
    "led": {
      "port": "E",
      "pin": 3,
      "activeLow": true
    }
  }
}
