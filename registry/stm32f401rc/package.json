{
  "name": "stm32f401rc",
  "version": "1.0.0",
  "kind": "board",
  "description": "STM32F401RC board package with an inverted red LED on PC13",
  "license": "MIT",
  "dependencies": {
    "llvm-wasm": "^1.0.0",
    "cmsis-stm32f4": "^1.0.0"
  },
  "metadata": {
    "manufacturer": "STMicroelectronics",
    "mcu": "STM32F401RC",
    "package": "LQFP64",
    "architecture": "armv7e-m",
    "cpu": "cortex-m4",
    "build": {
      "kind": "bare-metal",
      "target": "armv7e-m",
      "targetOptions": {
        "mcpu": "cortex-m4"
      },
      "source": "main.c",
      "startupSource": "startup.c",
      "linkerScript": "stm32f401rc.ld",
      "output": ".wicro/build"
    },
    "fpu": "fpv4-sp-d16",
    "flashCapacityBytes": 262144,
    "sramCapacityBytes": 65536,
    "clockHz": 84000000,
    "flashAddress": "0x08000000",
    "sramAddress": "0x20000000",
    "leds": {
      "red": {
        "port": "C",
        "pin": 13,
        "activeLow": true
      }
    },
    "programmerId": "stm32-cdc-dfu",
    "usbVendorId": "0483",
    "usbProductId": "5740",
    "cdcDfu": {
      "runtimeVendorId": 1155,
      "runtimeProductId": 22336,
      "dfuVendorId": 1155,
      "dfuProductId": 57105,
      "interfaceNumber": 0,
      "alternateSetting": 0,
      "address": 134217728,
      "capacity": 262144,
      "ramAddress": 536870912,
      "ramCapacity": 65536,
      "protocol": "dfuse"
    }
  }
}
